<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
            http://www.liquibase.org/xml/ns/mongodb
            http://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-latest.xsd">

    <changeSet id="001-users-username-index" author="juan-carlos">
        <mongodb:createIndex collectionName="users">
            <mongodb:keys>{ username: 1 }</mongodb:keys>
            <mongodb:options>{ name: "username_1", unique: true }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="002-events-user-timestamp-index" author="juan-carlos">
        <mongodb:createIndex collectionName="events">
            <mongodb:keys>{ user_id: 1, timestamp: -1 }</mongodb:keys>
            <mongodb:options>{ name: "user_id_1_timestamp_-1" }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="003-alerts-user-created-index" author="juan-carlos">
        <mongodb:createIndex collectionName="alerts">
            <mongodb:keys>{ user_id: 1, created_at: -1 }</mongodb:keys>
            <mongodb:options>{ name: "user_id_1_created_at_-1" }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="004-sessions-user-started-index" author="juan-carlos">
        <mongodb:createIndex collectionName="sessions">
            <mongodb:keys>{ username: 1, started_at: -1 }</mongodb:keys>
            <mongodb:options>{ name: "username_1_started_at_-1" }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="005-integration-history-alert-created-index" author="juan-carlos">
        <mongodb:createIndex collectionName="integration_history">
            <mongodb:keys>{ alert_id: 1, created_at: -1 }</mongodb:keys>
            <mongodb:options>{ name: "alert_id_1_created_at_-1" }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

</databaseChangeLog>
